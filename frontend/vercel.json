{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://YOUR-BACKEND-URL.onrender.com/api/$1" },
    { "source": "/media/(.*)", "destination": "https://YOUR-BACKEND-URL.onrender.com/media/$1" },
    { "source": "/ws/(.*)", "destination": "https://YOUR-BACKEND-URL.onrender.com/ws/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}

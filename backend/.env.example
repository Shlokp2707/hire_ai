# Django core settings
DJANGO_SECRET_KEY=your-production-secret-key-here
DEBUG=False
ALLOWED_HOSTS=*
CORS_ALLOW_ALL_ORIGINS=True

# Database settings (For Supabase PostgreSQL connection URI)
# Option 1: Complete Connection URL from Supabase
DATABASE_URL=postgresql://postgres.xxx:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Option 2: Individual Supabase DB credentials (if DATABASE_URL is not set)
# USE_SQLITE=False
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=postgres
# DB_USER=postgres.xxxx
# DB_PASSWORD=your-supabase-db-password
# DB_HOST=aws-0-us-east-1.pooler.supabase.com
# DB_PORT=6543

# AI & API Services Keys
GROQ_API_KEY=your_groq_api_key
TAVILY_API_KEY=your_tavily_api_key
GOOGLE_API_KEY=your_google_gemini_api_key
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Email Service
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
